rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for display names)
      allow read: if request.auth != null;
      // Users can only create/update their own profile
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read posts (including anonymous ones - authorId is hidden client-side)
      allow read: if true;
      // Authenticated users can create posts
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      // Allow score/vote updates (open for anonymous voting)
      allow update: if request.resource.data.authorId == resource.data.authorId
        && request.resource.data.content == resource.data.content;
    }

    // Votes collection (open for anonymous voting)
    match /votes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // Company Sections
    match /companySections/{sectionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Section Posts
    match /sectionPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Section Replies
    match /sectionReplies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
    }

    // Section Access (payments)
    match /sectionAccess/{accessId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
