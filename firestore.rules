rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Only authenticated users can read profiles
      allow read: if request.auth != null;
      // Users can only create/update their own profile
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read posts (public feed)
      allow read: if true;
      // Authenticated users can create posts with validated fields
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.upvotes is int
        && request.resource.data.downvotes is int
        && request.resource.data.score is int
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.targetName is string
        && request.resource.data.isAnonymous is bool;
      // Path A: Author edits own post — freeze vote fields, hidden, and authorId
      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.upvotes == resource.data.upvotes
        && request.resource.data.downvotes == resource.data.downvotes
        && request.resource.data.score == resource.data.score
        && request.resource.data.hidden == resource.data.hidden;
      // Path B: Vote transactions — freeze ALL non-vote fields
      allow update: if request.resource.data.authorId == resource.data.authorId
        && request.resource.data.content == resource.data.content
        && request.resource.data.targetName == resource.data.targetName
        && request.resource.data.title == resource.data.title
        && request.resource.data.sentiment == resource.data.sentiment
        && request.resource.data.hidden == resource.data.hidden
        && request.resource.data.isAnonymous == resource.data.isAnonymous
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetLinks == resource.data.targetLinks
        && request.resource.data.upvotes is int
        && request.resource.data.downvotes is int
        && request.resource.data.score is int;
      // Path C: Admin operations (hide/unhide) — freeze authorId and vote fields
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.upvotes == resource.data.upvotes
        && request.resource.data.downvotes == resource.data.downvotes
        && request.resource.data.score == resource.data.score;
      // Only author or admin can delete
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.authorId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Votes collection — tightened rules for auth and anonymous voting
    match /votes/{voteId} {
      allow read: if true;
      // Authenticated users: voterId must match their uid
      allow create: if (request.auth != null && request.resource.data.voterId == request.auth.uid)
        // Anonymous users: userId must be empty, voterId must be non-empty string
        || (request.resource.data.userId == ""
            && request.resource.data.voterId is string
            && request.resource.data.voterId.size() > 0
            && request.resource.data.voteType in ["up", "down"]
            && request.resource.data.postId is string
            && request.resource.data.postId.size() > 0);
      // Delete: auth user owns it, or anon vote with matching voterId
      allow delete: if (request.auth != null && resource.data.userId == request.auth.uid)
        || (resource.data.userId == "" && resource.data.voterId is string);
    }

    // Company Sections — creator, staff, or admin can update
    match /companySections/{sectionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.creatorId
            || resource.data.staffIds.hasAny([request.auth.uid])
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Section Posts — paywall enforced via sectionAccessLookup
    match /sectionPosts/{postId} {
      allow read: if request.auth != null
        && (
          // User has paid for access to this section
          exists(/databases/$(database)/documents/sectionAccessLookup/$(request.auth.uid + '_' + resource.data.sectionId))
          // OR user is staff of the section
          || get(/databases/$(database)/documents/companySections/$(resource.data.sectionId)).data.staffIds.hasAny([request.auth.uid])
          // OR user is the section creator
          || get(/databases/$(database)/documents/companySections/$(resource.data.sectionId)).data.creatorId == request.auth.uid
          // OR user is admin
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.authorId;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.authorId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Section Replies — paywall enforced via sectionAccessLookup
    match /sectionReplies/{replyId} {
      allow read: if request.auth != null
        && (
          exists(/databases/$(database)/documents/sectionAccessLookup/$(request.auth.uid + '_' + resource.data.sectionId))
          || get(/databases/$(database)/documents/companySections/$(resource.data.sectionId)).data.staffIds.hasAny([request.auth.uid])
          || get(/databases/$(database)/documents/companySections/$(resource.data.sectionId)).data.creatorId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.authorId
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Section Access Lookup — server-write only, used for Firestore rule checks
    match /sectionAccessLookup/{lookupId} {
      allow read: if request.auth != null;
      allow create: if false; // server-side only
    }

    // Section Access (payments) — only created by server-side API
    match /sectionAccess/{accessId} {
      allow read: if request.auth != null;
      // Deny client-side creation — this is now handled server-side
      allow create: if false;
    }

    // Earnings — only created by server-side API
    match /earnings/{earningId} {
      allow read: if request.auth != null;
      // Deny client-side creation — this is now handled server-side
      allow create: if false;
    }

    // Notifications — users can read/update their own
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false; // server-side only
    }

    // Reports — authenticated users can create, admins can read/update
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Payout Requests — users can create/read their own, admins can read/update all
    match /payoutRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Waitlist — anyone can create (one entry per email), only admins can read
    match /waitlist/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.joinedAt is int;
    }
  }
}
